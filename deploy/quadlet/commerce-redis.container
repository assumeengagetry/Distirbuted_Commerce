[Unit]
Description=Distributed Commerce Redis

[Container]
Image=public.ecr.aws/docker/library/redis:7.4-alpine@sha256:9702d01c1f10c3ea9f48211b4362e44f154ff02d063e6f7268eba804059f53bf
ContainerName=commerce-redis
Network=pasta
Volume=commerce-redis.volume:/data
PublishPort=127.0.0.1:6379:6379
Secret=commerce-redis-config
Secret=commerce-redis-password,type=env,target=REDISCLI_AUTH
Exec=redis-server /run/secrets/commerce-redis-config
HealthCmd=redis-cli --user commerce ping 2>/dev/null | grep -qx PONG
HealthInterval=5s
HealthRetries=10
HealthStartPeriod=5s
HealthTimeout=3s
HealthOnFailure=kill
Notify=healthy
Memory=256m
PidsLimit=128
StopTimeout=20

[Service]
Restart=on-failure
RestartSec=2
TimeoutStartSec=120
TimeoutStopSec=30
