CACHE_REDIS_POOL_TIMEOUT=1s
CACHE_REDIS_POOL_SIZE=10
CACHE_REDIS_TLS_CA_FILE=
CACHE_REDIS_TLS_CERT_FILE=
CACHE_REDIS_TLS_KEY_FILE=
CACHE_REDIS_TLS_SERVER_NAME=
PRODUCT_CACHE_TTL=30s
PRODUCT_CACHE_OPERATION_TIMEOUT=100ms

QUEUE_REDIS_ADDR=127.0.0.1:6379
QUEUE_REDIS_USERNAME=commerce
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1
