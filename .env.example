APP_ENV=local
SERVICE_NAME=user-service
HTTP_ADDR=127.0.0.1:8081
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
LOG_LEVEL=debug

DATABASE_URL=postgres://commerce@127.0.0.1:5432/commerce?sslmode=disable
PGPASSFILE=.secrets/pgpass
DB_MAX_CONNS=20
DB_MIN_IDLE_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_LIFETIME_JITTER=5m
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_PING_TIMEOUT=2s
DB_OPERATION_TIMEOUT=5s
DB_LOCK_TIMEOUT=2s

TOKEN_ISSUER=distributed-commerce/user-service
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
TOKEN_CLOCK_SKEW=30s
REFRESH_REUSE_GRACE=5s
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_MAX_CONCURRENCY=2
AUTH_RATE_LIMIT_RPS=2
AUTH_RATE_LIMIT_BURST=5
AUTH_RATE_LIMIT_ENTRY_TTL=10m
AUTH_RATE_LIMIT_MAX_ENTRIES=10000
COMMERCE_RATE_LIMIT_RPS=20
COMMERCE_RATE_LIMIT_BURST=40
COMMERCE_RATE_LIMIT_ENTRY_TTL=10m
COMMERCE_RATE_LIMIT_MAX_ENTRIES=10000
